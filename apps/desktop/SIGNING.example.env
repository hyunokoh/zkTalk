# zkTalk desktop signing and notarization example
#
# Copy this file to a local env file or export these values in your shell
# before running signed release builds.

# macOS notarization
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=TEAMID1234

# Windows signing
WIN_CSC_LINK=/absolute/path/to/certificate.p12
WIN_CSC_KEY_PASSWORD=your-password

# Optional generic aliases supported by electron-builder
# CSC_LINK=/absolute/path/to/certificate.p12
# CSC_KEY_PASSWORD=your-password
