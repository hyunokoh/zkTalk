    "@fastify/websocket": "^11.0.0",
    "@zktalk/shared": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.0",
    "uuidv7": "^1.0.0",
    "ws": "^8.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@zktalk/eslint-config": "workspace:*",
    "@zktalk/typescript-config": "workspace:*",
    "drizzle-kit": "^0.30.0",
