{
  "name": "zktalk",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "release:next": "node scripts/release-next.mjs",
    "local:commercial:stack": "node scripts/local-commercial-stack.mjs",
    "local:commercial:verify": "node scripts/local-commercial-stack.mjs && pnpm --filter @zktalk/api run typecheck && pnpm --filter @zktalk/web run typecheck",
    "ime:report:init": "node scripts/init-ime-report.mjs",
    "desktop:harness:regression": "node scripts/desktop-harness-regression.mjs",
    "e2e:smoke:desktop": "node scripts/run-playwright-smoke.mjs --suite desktop",
    "e2e:smoke:web": "node scripts/run-playwright-smoke.mjs --suite web",
    "manual:smoke:brief": "node scripts/manual-smoke-brief.mjs",
    "manual:smoke:capture": "node scripts/manual-smoke-capture.mjs",
    "manual:smoke:open": "node scripts/manual-smoke-open.mjs",
    "manual:smoke:report": "node scripts/manual-smoke-report.mjs",
    "manual:smoke:refresh": "node scripts/manual-smoke-refresh.mjs",
    "manual:smoke:status": "node scripts/manual-smoke-status.mjs",
    "mobile:harness:find": "node scripts/find-mobile-simulator-harness.mjs",
    "mobile:harness:launch": "node scripts/launch-mobile-simulator-app.mjs",
    "mobile:harness:compose": "node scripts/mobile-simulator-message.mjs",
    "mobile:harness:regression": "node scripts/mobile-harness-regression.mjs",
    "mobile:standalone:prepare": "node scripts/prepare-mobile-standalone-simulator.mjs",
    "mobile:smoke": "node scripts/mobile-p0-smoke.mjs",
    "mobile:maestro:install": "node scripts/ensure-maestro-cli.mjs",
    "mobile:maestro:smoke": "node scripts/mobile-maestro-smoke.mjs",
    "mobile:maestro:both": "node scripts/mobile-maestro-smoke.mjs --app standalone --mode both --timeout-ms 120000 --maestro-timeout-ms 30000",
    "ui:smoke:all": "node scripts/run-ui-smoke-all.mjs",
    "ui:smoke:mobile": "node scripts/run-ui-smoke-mobile.mjs",
    "ui:smoke:macos": "node scripts/run-ui-smoke-macos.mjs",
    "ui:smoke:status": "node scripts/manual-smoke-status.mjs",
    "ui:smoke:brief": "node scripts/manual-smoke-brief.mjs",
    "ui:smoke:capture": "node scripts/manual-smoke-capture.mjs",
    "ui:smoke:report": "node scripts/manual-smoke-report.mjs",
    "ui:smoke:verify": "node scripts/manual-smoke-verify.mjs",
    "ui:smoke:rerun": "node scripts/manual-smoke-rerun.mjs",
    "ui:smoke:repair": "node scripts/manual-smoke-repair.mjs"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.20"
  }
}
