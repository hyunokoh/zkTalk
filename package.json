{
  "name": "zktalk",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify:hardening": ".zkcoder/scripts/verify.sh --hardening-batch",
    "verify:release-readiness": ".zkcoder/scripts/verify.sh --release-readiness",
    "verify:selected-message-ai": ".zkcoder/scripts/verify.sh --selected-message-ai",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "release:next": "node scripts/release-next.mjs",
    "operator:handoff:check": "node scripts/check-operator-handoff.mjs",
    "operator:smoke:inventory": "node scripts/operator-smoke-inventory.mjs",
    "local:commercial:stack": "node scripts/local-commercial-stack.mjs",
    "local:commercial:seed": "node scripts/local-demo-seed.mjs",
    "local:commercial:verify": "node scripts/local-commercial-stack.mjs && pnpm --filter @zktalk/api run typecheck && pnpm --filter @zktalk/web run typecheck",
    "ime:report:init": "node scripts/init-ime-report.mjs",
    "desktop:harness:regression": "node scripts/desktop-harness-regression.mjs",
    "e2e:smoke:desktop": "node scripts/local-commercial-stack.mjs && node scripts/run-playwright-smoke.mjs --suite desktop",
    "e2e:smoke:web:core": "node scripts/local-commercial-stack.mjs && node scripts/run-core-smoke.mjs",
    "e2e:isolated": "node scripts/run-isolated-lanes.mjs",
    "e2e:smoke:web": "node scripts/run-playwright-smoke.mjs --suite web",
    "manual:smoke:brief": "node scripts/manual-smoke-brief.mjs",
    "manual:smoke:capture": "node scripts/manual-smoke-capture.mjs",
    "manual:smoke:open": "node scripts/manual-smoke-open.mjs",
    "manual:smoke:report": "node scripts/manual-smoke-report.mjs",
    "manual:smoke:refresh": "node scripts/manual-smoke-refresh.mjs",
    "manual:smoke:status": "node scripts/manual-smoke-status.mjs",
    "mobile:harness:find": "node scripts/find-mobile-simulator-harness.mjs",
    "mobile:harness:launch": "node scripts/launch-mobile-simulator-app.mjs",
    "mobile:harness:compose": "node scripts/mobile-simulator-message.mjs",
    "mobile:harness:regression": "node scripts/mobile-harness-regression.mjs",
    "mobile:verify:parity": "pnpm --filter @zktalk/shared test -- --run src/__tests__/settings-navigation.test.ts src/__tests__/chat-surface-actions.test.ts src/__tests__/ai-selected-message.test.ts && pnpm --filter @zktalk/web test -- --run \"src/app/(app)/settings/__tests__/layout.test.tsx\" \"src/app/(app)/settings/__tests__/page.test.tsx\" \"src/app/(app)/settings/ai/__tests__/page.test.tsx\" \"src/app/(app)/communities/[slug]/channels/[channelId]/__tests__/layout.test.tsx\" \"src/app/(app)/communities/[slug]/channels/[channelId]/__tests__/page.test.tsx\" src/components/DmConversation/__tests__/DmConversation.test.tsx src/components/MessageItem/__tests__/MessageItem.test.tsx src/components/ThreadPanel/__tests__/ThreadPanel.test.tsx && node --test scripts/mobile-harness-regression.test.mjs",
    "mobile:verify:session-restore": "node scripts/mobile-harness-regression.mjs --app standalone --mode channel --launch --strict-consume",
    "test:mobile-risk-contracts": "node --test scripts/mobile-risk-contract.test.mjs scripts/mobile-harness-regression.test.mjs",
    "mobile:standalone:prepare": "node scripts/prepare-mobile-standalone-simulator.mjs",
    "mobile:smoke": "node scripts/mobile-p0-smoke.mjs",
    "mobile:maestro:install": "node scripts/ensure-maestro-cli.mjs",
    "mobile:maestro:smoke": "node scripts/mobile-maestro-smoke.mjs",
    "mobile:maestro:both": "node scripts/mobile-maestro-smoke.mjs --app standalone --mode both --timeout-ms 120000 --maestro-timeout-ms 30000",
    "mobile:maestro:selected-message-ai": "node scripts/mobile-maestro-smoke.mjs --app standalone --mode selected-message-ai --timeout-ms 120000 --maestro-timeout-ms 30000",
    "mobile:maestro:selected-message-ai:dm": "node scripts/mobile-maestro-smoke.mjs --app standalone --mode selected-message-ai-dm --timeout-ms 120000 --maestro-timeout-ms 30000",
    "mobile:maestro:selected-message-ai:thread": "node scripts/mobile-maestro-smoke.mjs --app standalone --mode selected-message-ai-thread --timeout-ms 120000 --maestro-timeout-ms 30000",
    "nightly:stabilize": "node scripts/nightly-stabilize.mjs",
    "ui:smoke:all": "node scripts/run-ui-smoke-all.mjs",
    "ui:smoke:mobile": "node scripts/run-ui-smoke-mobile.mjs",
    "ui:smoke:macos": "node scripts/run-ui-smoke-macos.mjs",
    "ui:smoke:status": "node scripts/manual-smoke-status.mjs",
    "ui:smoke:brief": "node scripts/manual-smoke-brief.mjs",
    "ui:smoke:capture": "node scripts/manual-smoke-capture.mjs",
    "ui:smoke:report": "node scripts/manual-smoke-report.mjs",
    "ui:smoke:verify": "node scripts/manual-smoke-verify.mjs",
    "ui:smoke:rerun": "node scripts/manual-smoke-rerun.mjs",
    "ui:smoke:repair": "node scripts/manual-smoke-repair.mjs"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.20"
  }
}
