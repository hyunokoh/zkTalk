# Database
DATABASE_URL=postgresql://zktalk:zktalk@localhost:5432/zktalk

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO
# Local commercial-stack scripts expect the bucket to exist as zktalk-uploads unless you override it.
# Use only the endpoint origin here, for example http://localhost:9000, not a bucket path.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=zktalk-uploads
S3_REGION=us-east-1

# API Server
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=change-this-to-a-random-secret
LOG_LEVEL=info

# Auth
MAGIC_LINK_SECRET=change-this-to-a-random-secret
EMAIL_LINK_SECRET=change-this-to-a-random-secret
MAGIC_LINK_EXPIRY_MINUTES=15

# OAuth
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# Frontend
# Browser-reachable base URLs; keep NEXT_PUBLIC_WS_URL on the /api/ws endpoint.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/ws
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Agent API Keys (for CI/CD or local tooling; not used by zkTalk API runtime)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# AI runtime provider
# AI_PROVIDER must be set explicitly for zkTalk API runtime to call an external AI provider.
# AI_PROVIDER=openrouter
# AI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL should be the canonical public app origin when using OpenRouter.
# OPENROUTER_SITE_URL=http://localhost:3000
# ZKTALK_PUBLIC_APP_URL=http://localhost:3000
# GEMINI_API_KEY=

# Translation (Google Translate API key, optional - falls back to AI_API_KEY)
# TRANSLATION_API_KEY=

# LiveKit API credentials (optional for local dev because the API has dev fallbacks)
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
