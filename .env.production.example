# ─── Database ───
POSTGRES_USER=zktalk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=zktalk

# ─── Redis ───
# (uses default settings in docker-compose)

# ─── S3 / MinIO ───
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
S3_BUCKET=zktalk-uploads
S3_REGION=us-east-1

# ─── API Server ───
CORS_ORIGIN=https://YOUR_DOMAIN
COOKIE_SECRET=CHANGE_ME_RANDOM_SECRET_32_CHARS
MAGIC_LINK_SECRET=CHANGE_ME_RANDOM_SECRET_32_CHARS

# ─── LiveKit (Voice/Video) ───
LIVEKIT_API_KEY=CHANGE_ME_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_API_SECRET

# ─── Frontend (build-time) ───
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api
NEXT_PUBLIC_WS_URL=wss://YOUR_DOMAIN/api/ws
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_DOMAIN:7881

# ─── Nginx ───
PORT=80
