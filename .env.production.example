# ─── Database ───
# docker-compose.prod.yml uses these values to build DATABASE_URL inside the API container.
POSTGRES_USER=zktalk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=zktalk
# Effective API runtime (derived by compose):
# DATABASE_URL=postgresql://zktalk:CHANGE_ME_STRONG_PASSWORD@postgres:5432/zktalk

# ─── Redis ───
# docker-compose.prod.yml provides REDIS_URL=redis://redis:6379 to the API container.
# Direct non-compose production runtimes must still provide REDIS_URL themselves.
# Effective API runtime (derived by compose):
# REDIS_URL=redis://redis:6379

# ─── S3 / MinIO ───
# Set S3_ENDPOINT only when using a non-AWS S3-compatible service such as MinIO or R2.
# Production API runtime no longer falls back to localhost when this is unset.
# Keep this pointed at the API-reachable endpoint, and pre-create the bucket before promotion.
# Use only the endpoint origin, for example https://storage.example.com, not a bucket path.
# This storage dependency is production-required, but it is currently outside `/api/health/ready`.
# Treat upload/download verification as a separate operator gate even when readiness is green.
# S3_ENDPOINT=https://YOUR_OBJECT_STORAGE_ENDPOINT
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
S3_BUCKET=zktalk-uploads
S3_REGION=us-east-1

# ─── API Server ───
# Exact public browser origin(s); comma-separate only when you intentionally allow more than one.
# Keep these public-origin values aligned with NEXT_PUBLIC_* and ZKTALK_PUBLIC_APP_URL.
# Direct non-compose production API runtimes must set DATABASE_URL, REDIS_URL, and PORT explicitly.
# docker-compose.prod.yml still has placeholder/dev fallbacks for some API and web values when these are unset.
# Treat rendered compose placeholder removal as a separate promotion gate; readiness does not validate it.
CORS_ORIGIN=https://YOUR_DOMAIN
COOKIE_SECRET=CHANGE_ME_RANDOM_SECRET_32_CHARS
MAGIC_LINK_SECRET=CHANGE_ME_RANDOM_SECRET_32_CHARS
EMAIL_LINK_SECRET=CHANGE_ME_RANDOM_SECRET_32_CHARS
# MAGIC_LINK_EXPIRY_MINUTES=15
ZKTALK_PUBLIC_APP_URL=https://YOUR_DOMAIN
AI_PROVIDER=openrouter
# Optional AI/translation provider credentials. docker-compose.prod.yml now forwards these
# explicitly to the API container when they are set here. Keep AI_PROVIDER aligned with
# the single provider key you intend to enable; keys alone no longer select a provider.
# OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
# OPENROUTER_SITE_URL=https://YOUR_DOMAIN
# AI_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
# GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
# TRANSLATION_API_KEY=CHANGE_ME_TRANSLATION_API_KEY

# Optional production auth provider client IDs. Set these only when the corresponding web/mobile sign-in
# flow is part of the release scope; missing values should stay in operator blocker notes, not runtime bugs.
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
# APPLE_CLIENT_ID=YOUR_APPLE_SERVICE_ID

# ─── LiveKit (Voice/Video) ───
# Voice/video is production-required, but current API readiness does not probe LiveKit directly.
# Confirm token issuance plus a real browser room join separately before promotion.
LIVEKIT_API_KEY=CHANGE_ME_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_API_SECRET

# ─── Frontend (build-time) ───
# Public browser-reachable endpoints embedded into the web build.
# These must describe the same externally reachable deployment as CORS_ORIGIN.
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api
NEXT_PUBLIC_WS_URL=wss://YOUR_DOMAIN/api/ws
NEXT_PUBLIC_LIVEKIT_URL=wss://LIVEKIT_PUBLIC_DOMAIN

# ─── Public Listener ───
# Host-facing nginx port. This is not the API container port; the API still runs on 4000 internally.
PORT=80
